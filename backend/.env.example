# Copy this file to .env and edit the values.
PORT=5000
# Leave DATABASE_URL empty to use a local SQLite file. Set it to your PostgreSQL URL in production.
DATABASE_URL=
# Set to true when the hosted PostgreSQL database requires SSL (Render, Neon, Railway).
DB_SSL=false
# Use a long random string, for example: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string
# Frontend address(es) allowed by CORS, comma separated, no trailing slash.
CLIENT_URL=http://localhost:5173
# First administrator account, created automatically on first start.
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@campusfix.edu
ADMIN_PASSWORD=Admin@12345
